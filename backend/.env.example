# ============================================================
# Pillar 5 Group — IT Ticketing System
# Backend Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit the real .env file.
# ============================================================

# === PostgreSQL Database ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=pillar5_tickets

# === Email — Microsoft Outlook / Office 365 ===
# SMTP_HOST for Outlook is always smtp.office365.com
# SMTP_PORT is always 587 (STARTTLS)
# Use your actual @pillar5group.co.za Outlook login credentials
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=you@pillar5group.co.za
SMTP_PASSWORD=your_outlook_password

# === Frontend URL (used in email links) ===
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# === JWT Secret ===
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_string

# === Server ===
PORT=5000
NODE_ENV=development

# === CORS (set to your deployed frontend URL in production) ===
ALLOWED_ORIGIN=http://localhost:5173

# === Initial SUPER_ADMIN account ===
# Seeded once at first boot if a user with this email doesn't already exist.
# Leave unset to skip seeding (e.g. once you already have an admin in the DB).
DEFAULT_ADMIN_EMAIL=you@pillar5group.co.za
DEFAULT_ADMIN_PASSWORD=choose_a_strong_password
